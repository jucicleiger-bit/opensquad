# Copy to .env and fill in before `docker compose up -d`.
# AUTHENTICATION_API_KEY is the Evolution admin key. It goes into
# OPENSQUAD_EVOLUTION_ADMIN_APIKEY on the content-central-server process
# (see that repo's own .env/.env.example) — never stored per project, never
# sent to the browser. Treat it as a real secret, don't commit the real .env.
AUTHENTICATION_API_KEY=troque-esta-chave
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@postgres:5432/evolution
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379
