# Instagram Graph API — https://developers.facebook.com/docs/instagram-api/
# Requires an Instagram Business account connected to a Facebook Page.
# Get your token from: Meta for Developers → Graph API Explorer
# Required scope: instagram_content_publish

INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_user_id_here

# Image hosting (imgBB) — https://api.imgbb.com/
# Required for instagram-publisher skill AND for Central de Conteúdo's real
# publishing (Meta's Graph API fetches the image itself from a public URL —
# a local file on your machine isn't reachable). Get a free API key at
# https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key_here

# Central de Conteúdo — publicação real no Instagram/Facebook.
# Desligado por padrão de propósito: publicar é uma ação pública e difícil
# de desfazer. Só defina como "true" quando você já revisou o fluxo e quer
# que o painel publique de verdade os cards aprovados no horário agendado.
# OPENSQUAD_ENABLE_REAL_PUBLISHING=true
# De quanto em quanto tempo o painel verifica se há conteúdo aprovado e
# vencido pra publicar (em milissegundos). Padrão: 180000 (3 minutos).
# OPENSQUAD_PUBLISH_CHECK_INTERVAL_MS=180000
# Se a Meta rejeitar a imagem por falha passageira (ex: URL ainda propagando
# no CDN do host de imagem), o painel tenta de novo automaticamente dentro da
# mesma tentativa, sem esperar o próximo ciclo. Padrões: 3 tentativas, 4000ms
# de espera entre elas (dobra a cada tentativa), 2500ms de espera após o
# upload antes de mandar pra Meta.
# OPENSQUAD_PUBLISH_RETRY_ATTEMPTS=3
# OPENSQUAD_PUBLISH_RETRY_DELAY_MS=4000
# OPENSQUAD_PUBLISH_SETTLE_DELAY_MS=2500

# Path to a local clone of the private "gaveta" repo (see docs/superpowers/specs/2026-08-10-github-actions-scheduled-publisher-design.md).
# When unset, approve/regenerate/delete behave exactly as before this feature existed.
OPENSQUAD_GAVETA_DIR=

# Set to "false" on the local PC once the gaveta repo's hourly GitHub Action
# is live, so only GitHub — never the local PC — runs the time-based sweep.
# OPENSQUAD_ENABLE_REAL_PUBLISHING stays "true" so "Publicar agora" keeps working.
OPENSQUAD_AUTO_PUBLISH_SCHEDULER=

# Repo the server runs `gh secret set` against (via `gh`'s own stored auth —
# see `gh auth status`) whenever a project's Meta token is saved/rotated.
OPENSQUAD_GAVETA_REPO=   # e.g. jucicleiger-bit/opensquad-gaveta

# Central de Conteúdo — e-mail proativo quando um token da Meta está
# vencendo/vencido ou uma publicação agendada falhou, sem precisar abrir o
# painel. Ligado por padrão; envia pelo Gmail já autenticado no Hermes
# (mesmo mecanismo que os squads antigos já usam para e-mail de aprovação).
# Cada alerta só reenvia depois do cooldown, pra não spammar a cada 15 min.
# OPENSQUAD_ENABLE_ALERT_EMAILS=false
# OPENSQUAD_ALERTS_EMAIL=juciclei.ger@gmail.com
# OPENSQUAD_ALERT_EMAIL_CHECK_INTERVAL_MS=900000

# AI image generation for Central de Conteúdo — which provider to call.
# "openai" (default), "xai" (Grok Imagine), "nous" (Nous Portal managed
# FAL gateway), or "codex" (ChatGPT/Codex OAuth — gpt-image-2 via your own
# ChatGPT subscription, no per-token API billing).
# OPENSQUAD_IMAGE_PROVIDER=openai

# ChatGPT/OpenAI Images — https://platform.openai.com/api-keys
# Used by Central de Conteúdo when generating AI images.
# Prefer OPENSQUAD_OPENAI_API_KEY for this project only.
OPENSQUAD_OPENAI_API_KEY=your_openai_api_key_here
OPENSQUAD_OPENAI_IMAGE_MODEL=gpt-image-1
# For Story/Reels and vertical Feed. Leave commented to let Opensquad choose by channel.
# OPENSQUAD_OPENAI_IMAGE_SIZE=1024x1536

# xAI / Grok Imagine — https://docs.x.ai/docs/guides/image-generations
# Only used when OPENSQUAD_IMAGE_PROVIDER=xai.
# Reuses the xAI OAuth (SuperGrok) credential already logged into the Hermes
# agent on this machine (`hermes model` → Anthropic/xAI) when present — no
# key needed here in that case. Set XAI_API_KEY as a fallback (pay-per-use,
# separate billing from a SuperGrok subscription; needs credits purchased at
# console.x.ai).
# XAI_API_KEY=your_xai_api_key_here
# OPENSQUAD_XAI_IMAGE_MODEL=grok-imagine-image
# OPENSQUAD_XAI_IMAGE_RESOLUTION=1k

# Nous Portal managed FAL gateway — https://portal.nousresearch.com
# Only used when OPENSQUAD_IMAGE_PROVIDER=nous. Requires a Nous Portal
# subscription with the Tool Gateway's image generation enabled, logged in
# via the Hermes agent on this machine (`hermes setup --portal` or
# `hermes model` → Nous Portal). No separate key needed here — billing runs
# against the Nous subscription, not a per-provider API key.
# OPENSQUAD_NOUS_IMAGE_MODEL=fal-ai/gpt-image-2

# ChatGPT/Codex OAuth — no key needed here at all.
# Only used when OPENSQUAD_IMAGE_PROVIDER=codex. Reuses the ChatGPT/Codex
# OAuth login already active in the Hermes agent on this machine (the same
# login used by `hermes chat`/Codex CLI). Routes through
# chatgpt.com/backend-api/codex (gpt-image-2), billed against your ChatGPT
# subscription's normal usage — not the pay-per-token OPENAI_API_KEY path.
# Good fallback when the OpenAI API billing account is capped but ChatGPT
# itself still works.
